# Google Cloud OAuth 2.0 Web application credentials. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URL=http://127.0.0.1:4000/api/google-meet/oauth/callback
GOOGLE_MEET_FRONTEND_REDIRECT_URL=http://localhost:5173/inbox/direct

# Generate once and store in the team's secret manager for every environment.
GOOGLE_MEET_STATE_SECRET=
GOOGLE_MEET_TOKEN_ENCRYPTION_KEY=
