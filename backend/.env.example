DB_USER=username_example
DB_HOST=hostname_example
DB_NAME=database_name_example
DB_PASSWORD=password_example
DB_PORT=port_number_example
REDIS_URL=redis://127.0.0.1:6379
# Use in-memory Redis for local dev if your Redis needs a password you have not configured:
# REDIS_USE_MEMORY=true
REFRESH_TOKEN_JWT_SECRET=refresh_token_secret_key_example
ACCESS_TOKEN_JWT_SECRET=access_token_secret_key_example
MONGODB_URI=mongodb_uri_example

# Optional — defaults to http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional — required only for forum features (MongoDB)
# MONGODB_URI=mongodb://127.0.0.1:27017/ensemble